<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhotoLens Analyzer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="/static/vendor/echarts.min.js"></script>
<script src="/static/vendor/gsap.min.js"></script>
<script src="/static/vendor/ScrollTrigger.min.js"></script>
<link rel="stylesheet" href="/static/styles.css">
</head>
<body>
  <!-- Ambient background -->
  <div class="ambient-bg">
    <div class="ambient-orb ambient-orb--1"></div>
    <div class="ambient-orb ambient-orb--2"></div>
    <div class="ambient-orb ambient-orb--3"></div>
  </div>

  <!-- Header -->
  <header class="header" id="header">
    <div class="header-inner">
      <div class="logo" id="logo">
        <div class="logo-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v4m0 12v4m10-10h-4M6 12H2m15.07-5.07l-2.83 2.83M9.76 14.24l-2.83 2.83m11.14 0l-2.83-2.83M9.76 9.76L6.93 6.93"/>
          </svg>
        </div>
        <div class="logo-text">
          <h1>PhotoLens<span class="logo-accent">.</span></h1>
          <span class="logo-tagline">EXIF Intelligence</span>
        </div>
      </div>
      <nav class="header-nav" id="header-nav">
        <button class="nav-btn nav-btn--active" data-view="upload" onclick="showView('upload')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Upload
        </button>
        <button class="nav-btn" data-view="dashboard" onclick="showView('dashboard')" id="nav-dashboard" style="display:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard
        </button>
      </nav>
    </div>
  </header>

  <!-- Upload View -->
  <main id="view-upload" class="view view--active">
    <section class="upload-section">
      <div class="upload-hero">
        <div class="upload-hero__badge">Multi-format EXIF Analysis</div>
        <h2 class="upload-hero__title">Discover your shooting DNA</h2>
        <p class="upload-hero__desc">Upload your photos to unlock detailed focal length, aperture, and ISO insights. Supports JPEG, RAW, HEIF, TIFF, PNG.</p>
      </div>

      <div class="upload-zone" id="upload-zone" tabindex="0" role="button" aria-label="Upload photos">
        <div class="upload-zone__ring">
          <svg class="upload-zone__ring-svg" viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="90" fill="none" stroke="url(#ring-grad)" stroke-width="1" stroke-dasharray="6 4" opacity="0.5"/>
            <defs>
              <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="var(--accent)"/>
                <stop offset="100%" stop-color="var(--accent-end)"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="upload-zone__icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <h3 class="upload-zone__title">Drop photos here</h3>
        <p class="upload-zone__sub">or click to browse</p>
        <div class="upload-zone__formats">
          <span class="format-tag">JPEG</span>
          <span class="format-tag">RAW</span>
          <span class="format-tag">HEIF</span>
          <span class="format-tag">TIFF</span>
          <span class="format-tag">PNG</span>
        </div>
        <input type="file" id="file-input" multiple accept="image/*,.arw,.cr2,.cr3,.nef,.orf,.raf,.rw2,.dng,.pef,.heif,.heic" hidden>
        <button class="btn-primary" onclick="event.stopPropagation(); document.getElementById('file-input').click()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Select Photos
        </button>
      </div>

      <div class="upload-progress" id="upload-progress">
        <div class="upload-progress__bar">
          <div class="upload-progress__fill" id="progress-fill"></div>
        </div>
        <div class="upload-progress__info">
          <span id="progress-text">Preparing...</span>
          <span id="progress-pct">0%</span>
        </div>
      </div>

      <div class="upload-features">
        <div class="feature-card" data-feature>
          <div class="feature-card__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4m10-10h-4M6 12H2m15.07-5.07l-2.83 2.83M9.76 14.24l-2.83 2.83m11.14 0l-2.83-2.83M9.76 9.76L6.93 6.93"/></svg>
          </div>
          <h4>35mm Equivalent</h4>
          <p>Auto-converts to full-frame equivalent with 1000+ camera crop factors</p>
        </div>
        <div class="feature-card" data-feature>
          <div class="feature-card__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <h4>Lens Intelligence</h4>
          <p>AI-powered recommendations for lens upgrades based on your shooting patterns</p>
        </div>
        <div class="feature-card" data-feature>
          <div class="feature-card__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <h4>Rich Dashboard</h4>
          <p>Interactive charts for focal length, aperture, ISO, timeline, and more</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Dashboard View -->
  <main id="view-dashboard" class="view">
    <section class="dashboard-section">
      <!-- Summary Stats -->
      <div class="stats-row" id="stats-row">
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--photos">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
          </div>
          <div class="stat-card__value" id="stat-total">0</div>
          <div class="stat-card__label">Photos</div>
        </div>
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--focal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4m10-10h-4M6 12H2"/></svg>
          </div>
          <div class="stat-card__value" id="stat-avg-focal">-</div>
          <div class="stat-card__label">Avg Focal Length</div>
        </div>
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--aperture">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="stat-card__value" id="stat-avg-aperture">-</div>
          <div class="stat-card__label">Avg Aperture</div>
        </div>
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--iso">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20m5-17H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="stat-card__value" id="stat-avg-iso">-</div>
          <div class="stat-card__label">Avg ISO</div>
        </div>
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--camera">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </div>
          <div class="stat-card__value" id="stat-cameras">0</div>
          <div class="stat-card__label">Cameras</div>
        </div>
        <div class="stat-card" data-stat>
          <div class="stat-card__icon stat-card__icon--lens">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" y1="8" x2="12" y2="8"/><line x1="3.95" y1="6.06" x2="8.54" y2="14"/><line x1="10.88" y1="21.94" x2="15.46" y2="14"/></svg>
          </div>
          <div class="stat-card__value" id="stat-lenses">0</div>
          <div class="stat-card__label">Lenses</div>
        </div>
      </div>

      <!-- Charts Grid -->
      <div class="charts-grid">
        <div class="chart-card chart-card--wide" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Focal Length Distribution</h3>
              <span class="chart-card__tag">Groups</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-focal-group"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Focal Length Details</h3>
              <span class="chart-card__tag">mm</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-focal-bar"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Aperture Distribution</h3>
              <span class="chart-card__tag">f-stop</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-aperture"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>ISO Distribution</h3>
              <span class="chart-card__tag">sensitivity</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-iso"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Camera Usage</h3>
              <span class="chart-card__tag">by model</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-camera"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Lens Usage</h3>
              <span class="chart-card__tag">by model</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-lens"></div>
          </div>
        </div>

        <div class="chart-card chart-card--wide" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Shooting Timeline</h3>
              <span class="chart-card__tag">monthly</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart chart--timeline" id="chart-timeline"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Shooting by Hour</h3>
              <span class="chart-card__tag">time of day</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-hourly"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>Day of Week</h3>
              <span class="chart-card__tag">weekly</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-dow"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3>File Format</h3>
              <span class="chart-card__tag">by type</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-format"></div>
          </div>
        </div>
      </div>

      <!-- Recommendations -->
      <div class="recs-card" id="recommendations" style="display:none">
        <div class="chart-card__head">
          <div class="chart-card__title-group">
            <h3>Lens Upgrade Recommendations</h3>
            <span class="chart-card__tag tag--ai">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              AI insights
            </span>
          </div>
        </div>
        <div class="recs-list" id="recommendations-list"></div>
      </div>

      <!-- Data Table -->
      <div class="table-card">
        <div class="chart-card__head">
          <div class="chart-card__title-group">
            <h3>Photo Details</h3>
            <span class="chart-card__tag" id="table-count">0 photos</span>
          </div>
          <div class="table-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="table-filter" placeholder="Search photos..." oninput="filterTable(this.value)">
          </div>
        </div>
        <div class="table-wrapper">
          <table id="data-table">
            <thead>
              <tr>
                <th>Filename</th>
                <th>Camera</th>
                <th>Lens</th>
                <th>Focal (mm)</th>
                <th>35mm Eq</th>
                <th>Group</th>
                <th>Aperture</th>
                <th>ISO</th>
                <th>Shutter</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody id="table-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Action Bar -->
      <div class="action-bar">
        <button class="btn-secondary" onclick="resetApp()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          New Analysis
        </button>
      </div>
    </section>
  </main>

<script src="/static/app.js"></script>
</body>
</html>
