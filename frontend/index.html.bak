<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhotoLens Analyzer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="vendor/echarts.min.js"></script>
<script src="vendor/gsap.min.js"></script>
<script src="vendor/ScrollTrigger.min.js"></script>
<link rel="stylesheet" href="styles.css">
</head>
<body>
  <!-- Ambient background -->
  <div class="ambient-bg">
    <div class="ambient-orb ambient-orb--1"></div>
    <div class="ambient-orb ambient-orb--2"></div>
    <div class="ambient-orb ambient-orb--3"></div>
  </div>

  <!-- Header -->
  <header class="header" id="header">
    <div class="header-inner">
      <div class="logo" id="logo">
        <div class="logo-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M12 2v4m0 12v4m10-10h-4M6 12H2m15.07-5.07l-2.83 2.83M9.76 14.24l-2.83 2.83m11.14 0l-2.83-2.83M9.76 9.76L6.93 6.93"/>
          </svg>
        </div>
        <div class="logo-text">
          <h1>PhotoLens<span class="logo-accent">.</span></h1>
          <span class="logo-tagline">EXIF Intelligence</span>
        </div>
      </div>
      <nav class="header-nav" id="header-nav">
        <button class="nav-btn nav-btn--active" data-view="upload" onclick="showView('upload')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span data-i18n="nav.upload">上传</span>
        </button>
        <button class="nav-btn" data-view="dashboard" onclick="showView('dashboard')" id="nav-dashboard" style="display:none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          <span data-i18n="nav.dashboard">数据面板</span>
        </button>
      </nav>
      <div class="header-controls" id="header-controls">
        <button class="theme-toggle" id="theme-toggle" onclick="toggleTheme()" title="切换主题">
          <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <button class="lang-toggle" id="lang-toggle" onclick="toggleLang()" title="切换语言">
          <span id="lang-label">中/EN</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Upload View -->
  <main id="view-upload" class="view view--active">
    <section class="upload-section">
      <div class="upload-hero">
        <div class="upload-hero__badge" data-i18n="hero.badge">多格式 EXIF 分析</div>
        <h2 class="upload-hero__title" data-i18n="hero.title">发现你的拍摄基因</h2>
        <p class="upload-hero__desc" data-i18n="hero.desc">上传照片，解锁焦距、光圈和 ISO 的详细洞察。支持 JPEG、RAW、HEIF、TIFF、PNG。</p>
      </div>

      <div class="upload-zone" id="upload-zone" tabindex="0" role="button" aria-label="Upload photos">
        <div class="upload-zone__ring">
          <svg class="upload-zone__ring-svg" viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="90" fill="none" stroke="url(#ring-grad)" stroke-width="1" stroke-dasharray="6 4" opacity="0.5"/>
            <defs>
              <linearGradient id="ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="var(--accent)"/>
                <stop offset="100%" stop-color="var(--accent-end)"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="upload-zone__icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <h3 class="upload-zone__title" data-i18n="upload.drop">拖放照片到此处</h3>
        <p class="upload-zone__sub" data-i18n="upload.or">或点击浏览文件</p>
        <div class="upload-zone__formats">
          <span class="format-tag">JPEG</span>
          <span class="format-tag">RAW</span>
          <span class="format-tag">HEIF</span>
          <span class="format-tag">TIFF</span>
          <span class="format-tag">PNG</span>
        </div>
        <input type="file" id="file-input" multiple accept="image/*,.arw,.cr2,.cr3,.nef,.orf,.raf,.rw2,.dng,.pef,.heif,.heic,.tiff,.tif,.png,.gif,.bmp,.webp" hidden>
        <input type="file" id="folder-input" webkitdirectory directory multiple hidden>
        <div class="upload-actions">
          <button class="btn-primary" id="btn-select-files" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span data-i18n="upload.select">选择照片</span>
          </button>
          <button class="btn-secondary" id="btn-select-folder" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <span data-i18n="upload.folder">选择文件夹</span>
          </button>
        </div>
      </div>

      <!-- Upload Progress -->
      <div class="upload-progress" id="upload-progress">
        <div class="upload-progress__bar">
          <div class="upload-progress__fill" id="progress-fill"></div>
        </div>
        <div class="upload-progress__info">
          <span id="progress-text" data-i18n="upload.analyzing">正在分析照片...</span>
          <span id="progress-pct">0%</span>
        </div>
      </div>

      <!-- Upload Features -->
      <div class="upload-features">
        <div class="upload-feature">
          <div class="upload-feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v4m0 12v4m10-10h-4M6 12H2"/></svg>
          </div>
          <div class="upload-feature__title" data-i18n="feature.exif">EXIF 提取</div>
          <div class="upload-feature__desc" data-i18n="feature.exif.desc">完整的元数据解析</div>
        </div>
        <div class="upload-feature">
          <div class="upload-feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="upload-feature__title" data-i18n="feature.charts">可视化图表</div>
          <div class="upload-feature__desc" data-i18n="feature.charts.desc">交互式数据展示</div>
        </div>
        <div class="upload-feature">
          <div class="upload-feature__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div class="upload-feature__title" data-i18n="feature.insights">AI 洞察</div>
          <div class="upload-feature__desc" data-i18n="feature.insights.desc">智能镜头建议</div>
        </div>
      </div>
    </section>
  </main>

  <!-- Dashboard View -->
  <main id="view-dashboard" class="view">
    <section class="dashboard-section">
      <!-- Stats Row -->
      <div class="stats-row">
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--photos">📷</div>
          <div class="stat-card__value" id="stat-total">0</div>
          <div class="stat-card__label" data-i18n="stat.photos">照片总数</div>
        </div>
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--focal">🔭</div>
          <div class="stat-card__value" id="stat-avg-focal">-</div>
          <div class="stat-card__label" data-i18n="stat.focal">平均焦距</div>
        </div>
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--aperture">⭕</div>
          <div class="stat-card__value" id="stat-avg-aperture">-</div>
          <div class="stat-card__label" data-i18n="stat.aperture">平均光圈</div>
        </div>
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--iso">🔆</div>
          <div class="stat-card__value" id="stat-avg-iso">-</div>
          <div class="stat-card__label" data-i18n="stat.iso">平均 ISO</div>
        </div>
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--camera">📸</div>
          <div class="stat-card__value" id="stat-cameras">0</div>
          <div class="stat-card__label" data-i18n="stat.cameras">相机机身</div>
        </div>
        <div class="stat-card glass-card" data-stat>
          <div class="stat-card__icon stat-card__icon--lens">🔍</div>
          <div class="stat-card__value" id="stat-lenses">0</div>
          <div class="stat-card__label" data-i18n="stat.lenses">使用镜头</div>
        </div>
      </div>

      <!-- Charts Grid -->
      <div class="charts-grid">
        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.focalGroup">焦距分组</h3>
              <span class="chart-card__tag" data-i18n="chart.focalGroup.tag">分布</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-focal-group"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.focalBar">焦距分布</h3>
              <span class="chart-card__tag" data-i18n="chart.focalBar.tag">按毫米</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-focal-bar"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.aperture">光圈使用</h3>
              <span class="chart-card__tag" data-i18n="chart.aperture.tag">按 f 档</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-aperture"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.iso">ISO 分布</h3>
              <span class="chart-card__tag" data-i18n="chart.iso.tag">感光度</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-iso"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.camera">相机使用</h3>
              <span class="chart-card__tag" data-i18n="chart.camera.tag">按型号</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-camera"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.lens">镜头使用</h3>
              <span class="chart-card__tag" data-i18n="chart.lens.tag">按型号</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-lens"></div>
          </div>
        </div>

        <div class="chart-card chart-card--wide" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.timeline">拍摄时间线</h3>
              <span class="chart-card__tag" data-i18n="chart.timeline.tag">按月</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart chart--timeline" id="chart-timeline"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.hourly">按小时拍摄分布</h3>
              <span class="chart-card__tag" data-i18n="chart.hourly.tag">时段</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-hourly"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.dow">星期分布</h3>
              <span class="chart-card__tag" data-i18n="chart.dow.tag">按周</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-dow"></div>
          </div>
        </div>

        <div class="chart-card" data-chart>
          <div class="chart-card__head">
            <div class="chart-card__title-group">
              <h3 data-i18n="chart.format">文件格式</h3>
              <span class="chart-card__tag" data-i18n="chart.format.tag">按类型</span>
            </div>
          </div>
          <div class="chart-card__body">
            <div class="chart" id="chart-format"></div>
          </div>
        </div>
      </div>

      <!-- Recommendations -->
      <div class="recs-card" id="recommendations" style="display:none">
        <div class="chart-card__head">
          <div class="chart-card__title-group">
            <h3 data-i18n="recs.title">镜头升级建议</h3>
            <span class="chart-card__tag tag--ai">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span data-i18n="recs.ai">AI 洞察</span>
            </span>
          </div>
        </div>
        <div class="recs-list" id="recommendations-list"></div>
      </div>

      <!-- Data Table -->
      <div class="table-card">
        <div class="chart-card__head">
          <div class="chart-card__title-group">
            <h3 data-i18n="table.title">照片详情</h3>
            <span class="chart-card__tag" id="table-count">0 photos</span>
          </div>
          <div class="table-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="table-filter" data-i18n-placeholder="table.search" placeholder="搜索照片..." oninput="filterTable(this.value)">
          </div>
        </div>
        <div class="table-wrapper">
          <table id="data-table">
            <thead>
              <tr>
                <th data-i18n="table.th.filename">文件名</th>
                <th data-i18n="table.th.camera">相机</th>
                <th data-i18n="table.th.lens">镜头</th>
                <th data-i18n="table.th.focal">焦距 (mm)</th>
                <th data-i18n="table.th.equiv">等效焦距</th>
                <th data-i18n="table.th.group">分组</th>
                <th data-i18n="table.th.aperture">光圈</th>
                <th data-i18n="table.th.iso">ISO</th>
                <th data-i18n="table.th.shutter">快门</th>
                <th data-i18n="table.th.date">日期</th>
              </tr>
            </thead>
            <tbody id="table-body"></tbody>
          </table>
        </div>
      </div>

      <!-- Action Bar -->
      <div class="action-bar">
        <button class="btn-secondary" onclick="resetApp()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span data-i18n="action.reset">重新分析</span>
        </button>
      </div>
    </section>
  </main>

<script src="app.js"></script>
</body>
</html>
