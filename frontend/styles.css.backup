/* ============================================================
   PhotoLens Analyzer — Glassmorphism Premium Design System
   ============================================================ */

:root {
  /* ── Core Palette ── */
  --color-primary: #1E293B;
  --color-on-primary: #FFFFFF;
  --color-secondary: #334155;
  --color-on-secondary: #FFFFFF;
  --color-accent: #22C55E;
  --color-on-accent: #0F172A;
  --color-background: #0F172A;
  --color-foreground: #F8FAFC;
  --color-card: #1B2336;
  --color-card-foreground: #F8FAFC;
  --color-muted: #272F42;
  --color-muted-foreground: #94A3B8;
  --color-border: #475569;
  --color-destructive: #EF4444;
  --color-on-destructive: #000000;
  --color-ring: #FFFFFF;

  /* ── Semantic Colors ── */
  --bg-void: #06080d;
  --bg-base: #0a0e17;
  --bg-surface: #111827;
  --bg-elevated: #1a2235;
  --bg-card: rgba(17, 24, 39, 0.65);
  --bg-card-solid: #151d2e;
  --bg-hover: rgba(30, 41, 59, 0.6);

  --border: rgba(51, 65, 85, 0.5);
  --border-subtle: rgba(51, 65, 85, 0.25);

  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  --text-faint: #475569;

  /* ── Accent Colors ── */
  --accent: #22C55E;
  --accent-light: #4ADE80;
  --accent-dim: rgba(34, 197, 94, 0.12);
  --accent-glow: rgba(34, 197, 94, 0.06);
  --accent-end: #06b6d4;

  /* ── Chart Colors ── */
  --blue: #3b82f6;
  --blue-dim: rgba(59, 130, 246, 0.12);
  --purple: #a78bfa;
  --purple-dim: rgba(167, 139, 250, 0.12);
  --pink: #f472b6;
  --amber: #fbbf24;
  --amber-dim: rgba(251, 191, 36, 0.12);
  --cyan: #22d3ee;
  --rose: #fb7185;

  /* ── Spacing & Layout ── */
  --radius-sm: 8px;
  --radius: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-2xl: 24px;

  /* ── Shadows ── */
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
  --shadow: 0 4px 24px rgba(0,0,0,0.25);
  --shadow-lg: 0 12px 40px rgba(0,0,0,0.35);
  --shadow-glow: 0 0 60px rgba(34, 197, 94, 0.08);
  --shadow-glass: 0 8px 32px rgba(0,0,0,0.1);

  /* ── Glass Effects ── */
  --glass-blur: blur(16px);
  --glass-saturate: saturate(1.8);
  --glass-border: 1px solid rgba(255,255,255,0.08);
  --glass-shadow: 0 8px 32px rgba(0,0,0,0.1);

  /* ── Typography ── */
  --font-sans: 'Fira Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'Fira Code', 'SF Mono', Monaco, 'Cascadia Code', monospace;

  /* ── Layout ── */
  --header-h: 60px;
  --max-w: 1360px;
}

/* ── Reset ── */
*, *::before, *::after { 
  margin: 0; 
  padding: 0; 
  box-sizing: border-box; 
}

body {
  font-family: var(--font-sans);
  background: var(--bg-void);
  color: var(--text-primary);
  min-height: 100vh;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  position: relative;
}

/* ── Glass Morphism Utilities ── */
.glass {
  background: rgba(17, 24, 39, 0.65);
  backdrop-filter: var(--glass-blur) var(--glass-saturate);
  -webkit-backdrop-filter: var(--glass-blur) var(--glass-saturate);
  border: var(--glass-border);
  box-shadow: var(--glass-shadow);
}

.glass-light {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px) saturate(1.5);
  -webkit-backdrop-filter: blur(20px) saturate(1.5);
  border: 1px solid rgba(255,255,255,0.1);
}

.glass-card {
  background: rgba(27, 35, 54, 0.65);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-xl);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card:hover {
  background: rgba(27, 35, 54, 0.75);
  border-color: rgba(255,255,255,0.12);
  box-shadow: 0 12px 40px rgba(0,0,0,0.15);
  transform: translateY(-2px);
}

/* ── Ambient Background ── */
.ambient-bg {
  position: fixed; 
  inset: 0; 
  z-index: 0; 
  pointer-events: none; 
  overflow: hidden;
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.4;
  will-change: transform;
}

.ambient-orb--1 {
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(34,197,94,0.2), transparent 70%);
  top: -200px; left: -100px;
  animation: orbFloat1 25s ease-in-out infinite;
}

.ambient-orb--2 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(59,130,246,0.15), transparent 70%);
  top: 40%; right: -150px;
  animation: orbFloat2 30s ease-in-out infinite;
}

.ambient-orb--3 {
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(167,139,250,0.12), transparent 70%);
  bottom: -100px; left: 30%;
  animation: orbFloat3 20s ease-in-out infinite;
}

@keyframes orbFloat1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(80px, 40px) scale(1.1); }
  66% { transform: translate(-30px, 80px) scale(0.95); }
}

@keyframes orbFloat2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(-60px, -50px) scale(1.05); }
  66% { transform: translate(40px, 30px) scale(0.9); }
}

@keyframes orbFloat3 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(60px, -40px) scale(1.08); }
}

/* ── Header ── */
.header {
  position: sticky; 
  top: 0; 
  z-index: 100;
  height: var(--header-h);
  background: rgba(6, 8, 13, 0.8);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  transition: all 0.3s ease;
}

.header-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 28px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Logo */
.logo {
  display: flex; 
  align-items: center; 
  gap: 12px;
  cursor: pointer;
  transition: transform 0.3s ease;
}

.logo:hover {
  transform: scale(1.02);
}

.logo-icon {
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(6,182,212,0.2));
  border: 1px solid rgba(34,197,94,0.3);
  border-radius: 12px;
  color: var(--accent-light);
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(34,197,94,0.1);
}

.logo-icon:hover {
  transform: rotate(45deg) scale(1.1);
  box-shadow: 0 8px 24px rgba(34,197,94,0.2);
  border-color: rgba(34,197,94,0.5);
}

.logo-text h1 {
  font-size: 18px; 
  font-weight: 700; 
  letter-spacing: -0.02em;
  color: var(--text-primary); 
  line-height: 1.2;
}

.logo-accent { 
  color: var(--accent); 
  font-size: 20px;
}

.logo-tagline {
  font-size: 11px; 
  font-weight: 500; 
  color: var(--text-muted);
  letter-spacing: 0.06em; 
  text-transform: uppercase;
  opacity: 0.8;
}

/* Header Nav */
.header-nav {
  display: flex; 
  gap: 6px;
}

.nav-btn {
  display: inline-flex; 
  align-items: center; 
  gap: 8px;
  padding: 8px 16px;
  background: transparent; 
  border: 1px solid transparent;
  border-radius: var(--radius);
  color: var(--text-muted); 
  font-size: 13px; 
  font-weight: 500;
  cursor: pointer; 
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.nav-btn::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(34,197,94,0.1), rgba(6,182,212,0.1));
  opacity: 0;
  transition: opacity 0.3s ease;
}

.nav-btn:hover {
  color: var(--text-secondary); 
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.1);
}

.nav-btn:hover::before {
  opacity: 1;
}

.nav-btn--active {
  color: var(--accent-light); 
  background: rgba(34,197,94,0.15);
  border-color: rgba(34,197,94,0.3);
  box-shadow: 0 4px 12px rgba(34,197,94,0.1);
}

.nav-btn--active::before {
  opacity: 1;
}

/* ── Views ── */
.view { 
  display: none; 
  position: relative; 
  z-index: 1; 
}

.view--active { 
  display: block; 
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── Upload Section ── */
.upload-section {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 60px 28px 40px;
}

.upload-hero {
  text-align: center;
  margin-bottom: 48px;
}

.upload-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  background: rgba(34,197,94,0.1);
  border: 1px solid rgba(34,197,94,0.2);
  border-radius: 20px;
  color: var(--accent-light);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 24px;
  backdrop-filter: blur(10px);
  animation: badgePulse 3s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0.3); }
  50% { box-shadow: 0 0 20px 5px rgba(34,197,94,0.1); }
}

.upload-hero__title {
  font-size: 48px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 16px;
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 50%, var(--accent-end) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.upload-hero__desc {
  font-size: 16px;
  color: var(--text-secondary);
  max-width: 480px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Upload Zone */
.upload-zone {
  position: relative;
  max-width: 520px;
  margin: 0 auto 60px;
  padding: 60px 40px;
  background: rgba(27, 35, 54, 0.4);
  backdrop-filter: blur(24px) saturate(1.5);
  -webkit-backdrop-filter: blur(24px) saturate(1.5);
  border: 2px dashed rgba(255,255,255,0.1);
  border-radius: var(--radius-2xl);
  text-align: center;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  outline: none;
  overflow: hidden;
}

.upload-zone::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(34,197,94,0.05), rgba(6,182,212,0.05));
  opacity: 0;
  transition: opacity 0.4s ease;
  border-radius: inherit;
}

.upload-zone:hover {
  border-color: rgba(34,197,94,0.4);
  transform: translateY(-4px);
  box-shadow: 0 20px 60px rgba(34,197,94,0.1);
}

.upload-zone:hover::before {
  opacity: 1;
}

.upload-zone.drag-over {
  border-color: var(--accent);
  background: rgba(34,197,94,0.08);
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 24px 80px rgba(34,197,94,0.15);
}

.upload-zone:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

.upload-zone__ring {
  position: absolute;
  inset: -20px;
  pointer-events: none;
  opacity: 0.3;
  transition: opacity 0.4s ease;
}

.upload-zone:hover .upload-zone__ring {
  opacity: 0.6;
}

.upload-zone__ring-svg {
  width: 100%;
  height: 100%;
  animation: ringRotate 20s linear infinite;
}

@keyframes ringRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.upload-zone__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, rgba(34,197,94,0.2), rgba(6,182,212,0.2));
  border: 1px solid rgba(34,197,94,0.3);
  border-radius: 20px;
  margin-bottom: 24px;
  color: var(--accent-light);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 8px 24px rgba(34,197,94,0.15);
}

.upload-zone:hover .upload-zone__icon {
  transform: translateY(-8px) scale(1.1);
  box-shadow: 0 16px 40px rgba(34,197,94,0.25);
}

.upload-zone__title {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.upload-zone__sub {
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 24px;
}

.upload-zone__formats {
  display: flex;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

.format-tag {
  padding: 4px 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: all 0.3s ease;
}

.upload-zone:hover .format-tag {
  background: rgba(34,197,94,0.1);
  border-color: rgba(34,197,94,0.2);
  color: var(--accent-light);
}

/* Upload Features */
.upload-features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 800px;
  margin: 0 auto;
}

.upload-feature {
  text-align: center;
  padding: 24px 20px;
  background: rgba(27, 35, 54, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-xl);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.upload-feature:hover {
  background: rgba(27, 35, 54, 0.6);
  border-color: rgba(255,255,255,0.1);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.1);
}

.upload-feature__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, rgba(34,197,94,0.15), rgba(6,182,212,0.15));
  border: 1px solid rgba(34,197,94,0.2);
  border-radius: 14px;
  margin-bottom: 16px;
  color: var(--accent-light);
  transition: all 0.3s ease;
}

.upload-feature:hover .upload-feature__icon {
  transform: scale(1.1);
  box-shadow: 0 8px 20px rgba(34,197,94,0.2);
}

.upload-feature__title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.upload-feature__desc {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.5;
}

/* Upload Progress */
.upload-progress {
  max-width: 400px;
  margin: 0 auto 40px;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.upload-progress.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.progress-bar {
  height: 8px;
  background: rgba(255,255,255,0.08);
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 12px;
  position: relative;
}

.progress-bar::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-end));
  border-radius: 4px;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 20px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3));
  filter: blur(4px);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 13px;
  color: var(--text-muted);
}

.progress-pct {
  font-size: 13px;
  font-weight: 600;
  color: var(--accent-light);
  font-family: var(--font-mono);
}

/* Primary Button */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  background: linear-gradient(135deg, var(--accent), var(--accent-end));
  color: var(--color-on-accent);
  border: none;
  border-radius: var(--radius);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  margin-top: 20px;
}

.btn-primary::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(34,197,94,0.3);
}

.btn-primary:hover::before {
  opacity: 1;
}

.btn-primary:active {
  transform: translateY(0);
}

/* Upload action buttons */
.upload-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 24px;
  flex-wrap: wrap;
}

.btn-secondary-action {
  background: rgba(27, 35, 54, 0.8);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.12);
  color: var(--text-primary);
}

.btn-secondary-action::before {
  display: none;
}

.btn-secondary-action:hover {
  background: rgba(34,197,94,0.15);
  border-color: rgba(34,197,94,0.4);
  color: var(--accent-light);
  box-shadow: 0 8px 24px rgba(34,197,94,0.15);
}

/* ── Dashboard Section ── */
.dashboard-section {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 40px 28px;
}

/* Stats Row */
.stats-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
  margin-bottom: 32px;
}

.stat-card {
  background: rgba(27, 35, 54, 0.65);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-lg);
  padding: 20px 16px;
  text-align: center;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent-end));
  opacity: 0;
  transition: opacity 0.3s ease;
}

.stat-card:hover {
  background: rgba(27, 35, 54, 0.75);
  border-color: rgba(255,255,255,0.12);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.15);
}

.stat-card:hover::before {
  opacity: 1;
}

.stat-card__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: rgba(34,197,94,0.1);
  border: 1px solid rgba(34,197,94,0.2);
  border-radius: 12px;
  margin-bottom: 12px;
  color: var(--accent-light);
}

.stat-card__value {
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 4px;
  color: var(--text-primary);
  font-family: var(--font-mono);
}

.stat-card__label {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Charts Grid */
.charts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 32px;
}

.chart-card {
  background: rgba(27, 35, 54, 0.65);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-xl);
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.chart-card:hover {
  background: rgba(27, 35, 54, 0.75);
  border-color: rgba(255,255,255,0.12);
  transform: translateY(-4px);
  box-shadow: 0 16px 48px rgba(0,0,0,0.15);
}

.chart-card--wide {
  grid-column: span 2;
}

.chart-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.chart-card__title-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chart-card__title-group h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}

.chart-card__tag {
  padding: 3px 10px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.tag--ai {
  background: linear-gradient(135deg, rgba(34,197,94,0.15), rgba(6,182,212,0.15));
  border-color: rgba(34,197,94,0.3);
  color: var(--accent-light);
}

.chart-card__body {
  padding: 16px 24px 24px;
}

.chart {
  width: 100%;
  height: 300px;
}

.chart--timeline {
  height: 240px;
}

/* Recommendations */
.recs-card {
  background: rgba(27, 35, 54, 0.65);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: 28px;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.recs-card:hover {
  border-color: rgba(255,255,255,0.12);
  box-shadow: 0 16px 48px rgba(0,0,0,0.15);
}

.recs-list {
  padding: 16px 24px 24px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 16px;
}

.rec-item {
  position: relative;
  padding: 20px;
  background: rgba(26, 34, 53, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-lg);
  border-left: 3px solid var(--accent);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.rec-item:hover {
  background: rgba(30,41,59,0.8);
  transform: translateX(4px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}

.rec-title {
  font-size: 14px; 
  font-weight: 600;
  color: var(--accent-light);
  margin-bottom: 8px;
}

.rec-detail {
  font-size: 13px; 
  color: var(--text-secondary);
  margin-bottom: 8px; 
  line-height: 1.6;
}

.rec-suggestion {
  font-size: 12px; 
  color: var(--text-muted);
  line-height: 1.6;
  font-style: italic;
}

/* Table */
.table-card {
  background: rgba(27, 35, 54, 0.65);
  backdrop-filter: blur(20px) saturate(1.8);
  -webkit-backdrop-filter: blur(20px) saturate(1.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: 28px;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.table-card:hover {
  border-color: rgba(255,255,255,0.12);
  box-shadow: 0 16px 48px rgba(0,0,0,0.15);
}

.table-search {
  display: flex; 
  align-items: center; 
  gap: 10px;
  padding: 8px 14px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius);
  color: var(--text-muted);
  transition: all 0.3s ease;
}

.table-search:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(34,197,94,0.1);
}

.table-search input {
  background: none; 
  border: none; 
  outline: none;
  color: var(--text-primary);
  font-size: 13px; 
  font-family: inherit;
  width: 180px;
}

.table-search input::placeholder { 
  color: var(--text-faint); 
}

.table-wrapper {
  overflow-x: auto;
  padding: 8px 24px 20px;
}

table {
  width: 100%; 
  border-collapse: collapse; 
  font-size: 13px;
}

thead th {
  text-align: left; 
  padding: 12px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  color: var(--text-muted);
  font-weight: 600; 
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  white-space: nowrap;
  position: sticky; 
  top: 0;
  background: rgba(21, 29, 46, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2;
}

tbody td {
  padding: 10px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  white-space: nowrap;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

tbody tr { 
  transition: all 0.2s ease; 
}

tbody tr:hover td { 
  background: rgba(255,255,255,0.03);
  color: var(--text-primary); 
}

td.numeric {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
  font-family: var(--font-mono);
}

/* Action Bar */
.action-bar {
  text-align: center; 
  padding: 20px 0;
}

.btn-secondary {
  display: inline-flex; 
  align-items: center; 
  gap: 10px;
  padding: 12px 32px;
  background: rgba(27, 35, 54, 0.6);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--text-primary);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius);
  font-size: 14px; 
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-secondary:hover {
  background: rgba(27, 35, 54, 0.8);
  border-color: var(--accent);
  color: var(--accent-light);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(34,197,94,0.15);
}

.btn-secondary:active { 
  transform: translateY(0); 
}

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { 
  background: rgba(255,255,255,0.1); 
  border-radius: 4px; 
}
::-webkit-scrollbar-thumb:hover { 
  background: rgba(255,255,255,0.2); 
}

/* ── Selection ── */
::selection {
  background: rgba(34,197,94,0.3);
  color: var(--text-primary);
}

/* ── Reduced Motion ── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .ambient-orb { animation: none; }
  .upload-zone__ring-svg { animation: none; }
  .progress-bar::before { animation: none; }
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .stats-row { grid-template-columns: repeat(3, 1fr); }
  .upload-features { grid-template-columns: 1fr; max-width: 400px; }
  .charts-grid { grid-template-columns: repeat(2, 1fr); }
  .chart-card--wide { grid-column: span 2; }
}

@media (max-width: 768px) {
  :root { --header-h: 54px; }
  .header-inner { padding: 0 16px; }
  .logo-tagline { display: none; }
  .nav-btn span { display: none; }
  .upload-section, .dashboard-section { padding-left: 16px; padding-right: 16px; }
  .upload-zone { padding: 40px 20px; }
  .upload-zone__title { font-size: 16px; }
  .upload-hero__title { font-size: 36px; }
  .charts-grid { grid-template-columns: 1fr; }
  .chart-card--wide { grid-column: 1; }
  .chart { height: 260px; }
  .chart--timeline { height: 200px; }
  .stats-row { grid-template-columns: repeat(2, 1fr); }
  .stat-card__value { font-size: 24px; }
  .recs-list { grid-template-columns: 1fr; }
  .table-search input { width: 120px; }
}

@media (max-width: 480px) {
  .upload-hero__title { font-size: 28px; }
  .upload-hero__desc { font-size: 13px; }
  .stats-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .stat-card { padding: 16px 12px; }
  .upload-features { gap: 12px; }
  .upload-zone { padding: 32px 16px; }
  .upload-zone__icon { width: 64px; height: 64px; }
}

/* ── Loading States ── */
.loading-skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.05) 25%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0.05) 75%);
  background-size: 200% 100%;
  animation: skeleton 1.5s infinite;
  border-radius: var(--radius);
}

@keyframes skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── Tooltip ── */
.tooltip {
  position: relative;
}

.tooltip::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%) translateY(4px);
  padding: 6px 12px;
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-sm);
  font-size: 12px;
  color: var(--text-primary);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: all 0.2s ease;
  z-index: 1000;
}

.tooltip:hover::after {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* ── Focus States ── */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

button:focus-visible,
.nav-btn:focus-visible,
.upload-zone:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

/* ── Skip Link ── */
.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: var(--accent);
  color: var(--color-on-accent);
  padding: 8px 16px;
  z-index: 1000;
  transition: top 0.3s ease;
  font-weight: 600;
}

.skip-link:focus {
  top: 0;
}

/* ── Print Styles ── */
@media print {
  .header, .ambient-bg, .upload-zone, .action-bar {
    display: none !important;
  }
  
  body {
    background: white;
    color: black;
  }
  
  .glass-card, .stat-card, .chart-card, .table-card {
    background: white;
    border: 1px solid #ddd;
    box-shadow: none;
    backdrop-filter: none;
  }
}